#!/bin/sh

# Previene push directo a ramas protegidas desde la terminal local.
# Capa de seguridad complementaria a GitHub Branch Protection Rules.

branch="$(git rev-parse --abbrev-ref HEAD)"

if [ "$branch" = "main" ] || [ "$branch" = "master" ] || [ "$branch" = "develop" ]; then
  echo "BLOQUEADO: No puedes hacer push directo a '$branch'."
  echo "Crea un Pull Request desde tu feature branch."
  exit 1
fi
